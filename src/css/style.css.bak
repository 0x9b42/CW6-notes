:root {
  --paper: #161413;
  --paper-elevated: #1c1a18;
  --ink: #efedea;
  --ink-soft: #8e8881;
  --accent: #c2a06c;

  --rule: #2a2724;
  --rule-soft: #34302c;

  --serif: "Source Serif 4", Georgia, "Times New Roman", serif;
  --sans: "Inter", -apple-system, BlinkMacSystemFont, sans-serif;
  --mono: monospace;

  --measure: 76ch;
  --radius: 10px;
  --shadow: 0 10px 28px -18px rgba(0, 0, 0, 0.55);
}

*,
*::before,
*::after {
  box-sizing: border-box;
}

html {
  color-scheme: dark;
  scroll-behavior: smooth;
  scrollbar-width: thin;
  scrollbar-color: var(--rule) var(--paper);
}

::-webkit-scrollbar {
  width: 8px;
  height: 8px;
}

::-webkit-scrollbar-track {
  background: var(--paper);
}

::-webkit-scrollbar-thumb {
  background: var(--rule);
  border-radius: 4px;
}

::-webkit-scrollbar-thumb:hover {
  background: var(--ink-soft);
}

@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto !important;
  }

  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}

body {
  margin: 0;
  min-height: 100vh;
  background: var(--paper);
  color: var(--ink);
  font-family: var(--sans);
  line-height: 1.7;
  font-size: clamp(1rem, 2.5vw, 1.08rem);
  letter-spacing: 0.01em;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

::selection {
  background-color: var(--accent);
  color: var(--paper);
}

a {
  color: var(--accent);
  text-decoration-color: color-mix(in srgb, var(--accent) 70%, transparent);
  text-decoration-thickness: 1px;
  text-underline-offset: 0.18em;
  transition:
    color 0.2s ease,
    opacity 0.2s ease;
}

a:hover {
  color: color-mix(in srgb, var(--accent) 88%, white 12%);
}

a:focus-visible,
button:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 4px;
  border-radius: 4px;
}

.site-header {
  position: relative;
  z-index: 1;
  max-width: var(--measure);
  margin: 0 auto;
  padding: 3.5rem max(1.25rem, 5vw) 1.5rem;
}

.site-header .title {
  margin: 0;
  color: var(--ink);
  font-family: var(--serif);
  font-size: clamp(1.75rem, 2.1vw, 2.1rem);
  font-weight: 650;
  line-height: 1.25;
  letter-spacing: -0.02em;
}

.site-header .subtitle {
  margin: 0.6rem 0 0;
  color: var(--ink-soft);
  font-size: 0.98rem;
}

.site-nav {
  position: sticky;
  top: 0;
  z-index: 10;
  max-width: var(--measure);
  margin: 0 auto;
  padding: 0.85rem max(1.25rem, 5vw) 1rem;
  border-bottom: 1px solid var(--rule);
  background: rgba(22, 20, 19, 0.92);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  color: var(--ink-soft);
  font-family: var(--mono);
  font-size: 0.82rem;
}

main {
  position: relative;
  z-index: 1;
  max-width: var(--measure);
  margin: 0 auto;
  padding: 3.25rem max(1.25rem, 5vw) 6rem;
}

.entry-ref {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 1rem;
  margin-bottom: 1.5rem;
  padding-bottom: 1rem;
  border-bottom: 1px dashed var(--rule);
  color: var(--ink-soft);
  font-family: var(--mono);
  font-size: 0.82rem;
  letter-spacing: 0.02em;
}

.entry-ref .verse {
  color: var(--accent);
  font-weight: 600;
}

.parallel {
  position: relative;
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 2.25rem;
  margin-bottom: 2.5rem;
  padding: 1.5rem 0;
  border: 1px solid var(--rule);
  border-radius: var(--radius);
  overflow: hidden;
  background: var(--paper-elevated);
  box-shadow: var(--shadow);
}

.parallel::before {
  content: "";
  position: absolute;
  left: 50%;
  top: 1.15rem;
  bottom: 1.15rem;
  width: 1px;
  background: var(--rule-soft);
  transform: translateX(-1px);
}

.parallel > * {
  min-width: 0;
}

.parallel .lang-label {
  display: inline-block;
  margin-bottom: 0.75rem;
  padding: 2px 7px;
  border: 1px solid var(--rule);
  border-radius: 999px;
  color: var(--ink-soft);
  font-family: var(--mono);
  font-size: 0.7rem;
  text-transform: uppercase;
  letter-spacing: 0.11em;
}

.parallel .de,
.parallel .en {
  margin-inline: 1.25rem;
  font-family: var(--serif);
  font-size: clamp(0.95rem, 1vw + 0.55rem, 1.08rem);
  font-style: italic;
  line-height: 1.85;
  text-align: left;
  text-wrap: pretty;
  hyphens: auto;
}

.parallel .de {
  color: #f1eedc;
}

.commentary {
  font-family: var(--sans);
  font-size: 1rem;
  line-height: 1.8;
}

.commentary p {
  margin: 1.3em 0;
}

.commentary > p:first-of-type::first-letter {
  float: left;
  padding: 0.1em 0.12em 0 0;
  color: var(--accent);
  font-family: var(--serif);
  font-size: 3.2rem;
  line-height: 0.8;
}

.commentary h2,
.commentary h3 {
  margin-top: 2.4rem;
  margin-bottom: 1rem;
  padding-bottom: 0.5rem;
  border-bottom: 1px solid var(--rule);
  color: var(--accent);
  font-family: var(--sans);
  font-size: 0.84rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.commentary blockquote {
  margin: 1.5rem 0;
  padding: 1rem 1.4rem;
  border-left: 3px solid var(--accent);
  border-radius: 0 var(--radius) var(--radius) 0;
  background: #1a1816;
  color: var(--ink);
  font-family: var(--serif);
  font-size: 1.05rem;
  font-style: italic;
}

.vocab {
  margin-top: 3rem;
  padding: 1.5rem 1.5rem 1.5rem 1.9rem;
  border: 1px solid var(--rule);
  border-left: 4px solid var(--accent);
  border-radius: var(--radius);
  background: var(--paper-elevated);
  box-shadow: var(--shadow);
  font-size: 0.92rem;
}

.vocab .label {
  display: block;
  margin-bottom: 1rem;
  color: var(--ink-soft);
  font-family: var(--mono);
  font-size: 0.75rem;
  font-weight: 500;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.entry-list {
  margin: 0;
  padding: 0;
  list-style: none;
}

.entry-list li {
  position: relative;
  border-bottom: 1px solid var(--rule);
  transition: background 0.2s ease;
}

.entry-list li::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 2px;
  background: var(--accent);
  transform: scaleY(0);
  transform-origin: center;
  transition: transform 0.2s ease;
}

.entry-list li:hover {
  background: rgba(255, 255, 255, 0.015);
}

.entry-list li:hover::before {
  transform: scaleY(1);
}

.entry-list a {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 1rem;
  padding: 1.1rem 1rem 1.1rem 1.45rem;
  color: var(--ink);
  font-family: var(--serif);
  font-size: 1.12rem;
  text-decoration: none;
  background: none;
  transition:
    padding-left 0.2s ease,
    color 0.2s ease;
}

.entry-list a:hover {
  background: none;
  padding-left: 1.75rem;
}

.entry-list a::after {
  content: "→";
  opacity: 0;
  transform: translateX(-6px);
  color: var(--accent);
  font-family: var(--sans);
  font-size: 1rem;
  transition:
    opacity 0.2s ease,
    transform 0.2s ease;
}

.entry-list a:hover::after {
  opacity: 1;
  transform: translateX(0);
}

.entry-list .meta {
  display: block;
  margin-top: 0.35rem;
  margin-left: 0.35rem;
  color: var(--ink-soft);
  font-family: var(--mono);
  font-size: 0.8rem;
  font-weight: 400;
}

@media (max-width: 640px) {
  .site-header {
    padding-top: 2.5rem;
  }

  .site-nav {
    padding-top: 0.7rem;
    padding-bottom: 0.85rem;
  }

  main {
    padding-top: 2.1rem;
    padding-bottom: 4.5rem;
  }

  .parallel {
    grid-template-columns: 1fr;
    gap: 1.4rem;
    padding: 1.3rem 0;
  }

  .parallel::before {
    display: none;
  }

  .parallel .de,
  .parallel .en {
    margin-inline: 1rem;
    font-size: 0.98rem;
  }

  .commentary > p:first-of-type::first-letter {
    font-size: 3rem;
  }

  .entry-list a {
    padding-left: 1rem;
    font-size: 1.06rem;
  }

  .entry-list a:hover {
    padding-left: 1.12rem;
  }

  .entry-ref {
    flex-direction: column;
    align-items: flex-start;
  }
}
